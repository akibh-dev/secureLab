{
  "name": "securelab",
  "private": true,
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": "24.18.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "lint": "eslint . && prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "validate:labs": "bun scripts/compile-labs.ts --check && bun scripts/validate-labs.ts",
    "build": "bun run validate:labs && turbo run build",
    "test:e2e": "playwright test",
    "compile:labs": "bun scripts/compile-labs.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1",
    "eslint": "^9",
    "prettier": "^3",
    "prettier-plugin-astro": "^0",
    "turbo": "^2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8",
    "vitest": "^4",
    "yaml": "^2.9.1"
  }
}
