[
  {
    "id": "MVP-01",
    "slug": "authentication-is-not-authorization",
    "title": "Authentication Is Not Authorization",
    "version": 1,
    "module": "foundations",
    "difficulty": "Beginner",
    "minutes": 12,
    "prerequisites": [],
    "objective": "Return a project only to a verified project member.",
    "scenario": "Fieldnote is a fictional project workspace. Members need to read shared projects. The access policy must check who is in each project and use a consistent response when a project is unavailable.",
    "routes": [
      "GET /api/projects/:projectId"
    ],
    "invariants": {
      "rule": "Return a project only to a verified project member."
    },
    "hints": [
      "Think about the relationship between the verified actor and this project.",
      "Check membership after establishing the actor's identity.",
      "Require the verified actor's ID to appear in the project's member list."
    ],
    "cases": [
      {
        "id": "member",
        "label": "A verified member can read the project",
        "invariant": "rule",
        "action": "read",
        "fixture": {
          "actor": {
            "id": "reader-a",
            "tenant": "north",
            "permissions": [
              "read",
              "list"
            ]
          },
          "resource": {
            "tenant": "north",
            "owner": "owner-a",
            "members": [
              "reader-a",
              "owner-a"
            ],
            "visibility": "team",
            "open": true
          }
        },
        "expected": {
          "outcome": "allowed"
        },
        "group": "behavior",
        "weight": 1
      },
      {
        "id": "nonmember",
        "label": "An unrelated account receives a restricted result",
        "invariant": "rule",
        "action": "read",
        "fixture": {
          "actor": {
            "id": "reader-b",
            "tenant": "south",
            "permissions": [
              "read"
            ]
          },
          "resource": {
            "tenant": "north",
            "owner": "owner-a",
            "members": [
              "reader-a",
              "owner-a"
            ],
            "visibility": "team",
            "open": true
          }
        },
        "expected": {
          "outcome": "restricted"
        },
        "group": "boundary",
        "weight": 1
      },
      {
        "id": "missing",
        "label": "An unavailable project returns the same public result",
        "invariant": "rule",
        "action": "read",
        "fixture": {
          "actor": {
            "id": "reader-a",
            "tenant": "north",
            "permissions": [
              "read",
              "list"
            ]
          },
          "resource": null
        },
        "expected": {
          "outcome": "restricted"
        },
        "group": "boundary",
        "weight": 1
      },
      {
        "id": "anonymous",
        "label": "An unverified identity cannot read",
        "invariant": "rule",
        "action": "read",
        "fixture": {
          "actor": null,
          "resource": {
            "tenant": "north",
            "owner": "owner-a",
            "members": [
              "reader-a",
              "owner-a"
            ],
            "visibility": "team",
            "open": true
          }
        },
        "expected": {
          "outcome": "restricted"
        },
        "group": "boundary",
        "weight": 1
      }
    ],
    "explanation": "Authentication establishes identity. Project membership grants the read permission in this scenario. The unavailable response reveals no project details.",
    "references": [
      {
        "label": "OWASP API Security Top 10 (2023) · API1",
        "url": "https://owasp.org/API-Security/editions/2023/en/0x11-t10/"
      }
    ],
    "reasoning": [
      {
        "id": "relationship",
        "label": "Authorization depends on the actor's relationship to this project."
      },
      {
        "id": "ownership",
        "label": "Ownership is the only relationship that can grant read access."
      }
    ],
    "correctReason": "relationship",
    "mode": "choose-fix",
    "options": [
      {
        "id": "owners-only",
        "label": "Require the project owner",
        "checks": [
          "signed-in",
          "owner"
        ],
        "effect": "access"
      },
      {
        "id": "members",
        "label": "Require verified project membership",
        "checks": [
          "signed-in",
          "member"
        ],
        "effect": "access"
      }
    ],
    "solution": "members"
  },
  {
