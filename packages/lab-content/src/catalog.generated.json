        "invariant": "rule",
        "action": "read",
        "fixture": {
          "actor": {
            "id": "reader-b",
            "tenant": "south",
            "permissions": [
              "read"
            ]
          },
          "resource": {
            "tenant": "north",
            "owner": "owner-a",
            "members": [
              "reader-a",
              "owner-a"
            ],
            "visibility": "team",
            "open": true
          }
        },
        "expected": {
          "outcome": "restricted"
        },
        "group": "boundary",
        "weight": 30
      },
      {
