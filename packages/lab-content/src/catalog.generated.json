  {
    "id": "MVP-03",
    "slug": "role-vs-permission",
    "title": "Role vs Permission",
    "version": 1,
    "module": "authorization",
    "difficulty": "Intermediate",
    "minutes": 12,
    "prerequisites": [
      "MVP-02"
    ],
    "objective": "Require close permission, matching scope and an open ticket.",
    "scenario": "Relay Desk routes fictional tickets to supervisors. An authorized supervisor may close an open ticket in their workspace.",
    "routes": [
      "POST /api/tickets/:ticketId/close"
    ],
    "invariants": {
      "rule": "Require close permission, matching scope and an open ticket."
    },
    "hints": [
      "A role name describes a group of privileges.",
      "Check action scope and current business state together.",
      "Allow close only when permission, tenant and open state all match."
    ],
    "cases": [
      {
        "id": "close",
        "label": "A scoped supervisor closes an open ticket",
        "invariant": "rule",
        "action": "close",
        "fixture": {
          "actor": {
            "id": "supervisor-a",
            "tenant": "north",
            "permissions": [
              "close",
              "edit",
              "share"
            ]
          },
          "resource": {
            "tenant": "north",
            "owner": "owner-a",
            "members": [
              "reader-a",
              "owner-a"
            ],
            "visibility": "team",
            "open": true
          }
        },
        "expected": {
          "outcome": "allowed",
          "state": "closed"
        },
        "group": "behavior",
        "weight": 1
      },
      {
        "id": "no-permission",
        "label": "A reader cannot close a ticket",
        "invariant": "rule",
        "action": "close",
        "fixture": {
          "actor": {
            "id": "reader-a",
            "tenant": "north",
            "permissions": [
              "read",
              "list"
            ]
          },
          "resource": {
            "tenant": "north",
            "owner": "owner-a",
            "members": [
              "reader-a",
              "owner-a"
            ],
            "visibility": "team",
            "open": true
          }
        },
        "expected": {
          "outcome": "restricted"
        },
        "group": "boundary",
        "weight": 1
      },
      {
        "id": "other-scope",
        "label": "An out-of-scope supervisor cannot close",
        "invariant": "rule",
        "action": "close",
        "fixture": {
          "actor": {
            "id": "owner-a",
            "tenant": "south",
            "permissions": [
              "close",
              "edit",
              "share"
            ]
          },
          "resource": {
            "tenant": "north",
            "owner": "owner-a",
            "members": [
              "reader-a",
              "owner-a"
            ],
            "visibility": "team",
            "open": true
          }
        },
        "expected": {
          "outcome": "restricted"
        },
        "group": "boundary",
        "weight": 1
      },
      {
        "id": "closed",
        "label": "A previously closed ticket stays closed",
        "invariant": "rule",
        "action": "close",
        "fixture": {
          "actor": {
            "id": "owner-a",
            "tenant": "north",
            "permissions": [
              "close",
              "edit",
              "share"
            ]
          },
          "resource": {
            "tenant": "north",
            "owner": "owner-a",
            "members": [
              "reader-a",
              "owner-a"
            ],
            "visibility": "team",
            "open": false
          }
        },
        "expected": {
          "outcome": "restricted"
        },
        "group": "boundary",
        "weight": 1
      }
    ],
    "explanation": "Evaluate ticket scope, explicit action permission and current state before updating. In a real service enforce the state condition atomically with the write.",
    "references": [
      {
        "label": "OWASP API Security Top 10 (2023) · API5",
        "url": "https://owasp.org/API-Security/editions/2023/en/0x11-t10/"
      }
    ],
    "reasoning": [
      {
        "id": "principle",
        "label": "The permission applies to the action and tenant where the ticket is open."
      },
      {
        "id": "alternate",
        "label": "A supervisor must always personally own every ticket they close."
      }
    ],
    "correctReason": "principle",
    "mode": "choose-fix",
    "options": [
      {
        "id": "permitted",
        "label": "Require permission, tenant scope and open state",
        "checks": [
          "tenant",
          "permission",
          "open"
        ],
        "effect": "update"
      },
      {
        "id": "assigned",
        "label": "Additionally require personal ownership",
        "checks": [
          "tenant",
          "permission",
          "open",
          "owner"
        ],
        "effect": "update"
      }
    ],
    "solution": "permitted"
  },
  {
    "id": "MVP-04",
    "slug": "property-level-authorization",
    "title": "Property-Level Authorization",
    "version": 1,
    "module": "authorization",
    "difficulty": "Intermediate",
    "minutes": 12,
    "prerequisites": [
      "MVP-03"
    ],
    "objective": "Return only the approved fields for the authorized audience.",
    "scenario": "The fictional Commonroom directory provides team profiles. Owners can see their own contact preference. Internal metadata stays outside the public response model.",
    "routes": [
      "GET /api/profiles/:id"
    ],
    "invariants": {
      "rule": "Return only the approved fields for the authorized audience."
    },
    "hints": [
      "A permitted record can have fields with different audiences.",
      "Authorize the record, then build a separate response.",
      "Create a public field list and add contact preference only for the verified owner."
    ],
    "cases": [
      {
        "id": "team-fields",
        "label": "A teammate sees display name and bio",
        "invariant": "rule",
        "action": "read",
        "fixture": {
          "actor": {
            "id": "reader-a",
            "tenant": "north",
            "permissions": [
              "read",
              "list"
            ]
          },
          "resource": {
            "tenant": "north",
            "owner": "owner-a",
            "members": [
              "reader-a",
              "owner-a"
            ],
            "visibility": "team",
            "open": true
          }
        },
        "expected": {
          "outcome": "allowed",
          "fields": [
            "display-name",
            "bio"
          ]
        },
        "group": "behavior",
        "weight": 1
      },
      {
        "id": "self-fields",
        "label": "The owner also sees their contact preference",
        "invariant": "rule",
        "action": "read",
        "fixture": {
          "actor": {
            "id": "owner-a",
            "tenant": "north",
            "permissions": [
              "read",
              "list"
            ]
          },
          "resource": {
            "tenant": "north",
            "owner": "owner-a",
            "members": [
              "reader-a",
              "owner-a"
            ],
            "visibility": "team",
            "open": true
          }
        },
        "expected": {
          "outcome": "allowed",
          "fields": [
            "display-name",
            "bio",
            "contact-preference"
          ]
        },
        "group": "behavior",
        "weight": 1
      },
      {
        "id": "denied",
        "label": "An unapproved viewer receives no profile fields",
        "invariant": "rule",
        "action": "read",
        "fixture": {
          "actor": {
            "id": "reader-b",
            "tenant": "south",
            "permissions": [
              "read"
            ]
          },
          "resource": {
            "tenant": "north",
            "owner": "owner-a",
            "members": [
              "reader-a",
              "owner-a"
            ],
            "visibility": "team",
            "open": true
          }
        },
        "expected": {
          "outcome": "restricted"
        },
        "group": "boundary",
        "weight": 1
      }
    ],
    "explanation": "Allowlist the exact response keys for each authorized audience. Construct a new response object so new internal fields remain private by default.",
    "references": [
      {
        "label": "OWASP API Security Top 10 (2023) · API3",
        "url": "https://owasp.org/API-Security/editions/2023/en/0x11-t10/"
      }
    ],
    "reasoning": [
      {
        "id": "principle",
        "label": "Object access and visibility of individual properties are separate decisions."
      },
      {
        "id": "alternate",
        "label": "Every audience needs the same fixed representation."
      }
    ],
    "correctReason": "principle",
    "mode": "choose-fix",
    "options": [
      {
        "id": "one-view",
        "label": "Use the public field list for every viewer",
        "checks": [
          "tenant",
          "visible"
        ],
        "effect": "profile",
        "profile": "public"
      },
      {
        "id": "audience",
        "label": "Project fields by verified audience",
        "checks": [
          "tenant",
          "visible"
        ],
        "effect": "profile",
        "profile": "by-audience"
      }
    ],
    "solution": "audience"
  },
  {
    "id": "MVP-05",
    "slug": "validate-inputs-and-limit-work",
    "title": "Validate Inputs and Limit Work",
    "version": 1,
    "module": "resource-protection",
    "difficulty": "Intermediate",
    "minutes": 12,
    "prerequisites": [
      "MVP-04"
    ],
    "objective": "Validate pagination before accessing records.",
    "scenario": "The fictional Stockroom catalog defaults to page 1 with 20 items. It accepts page numbers 1–1000 and sizes 1–50. Invalid input must return a clear validation response before doing any reads.",
    "routes": [
      "GET /api/items?page=…&pageSize=…"
    ],
    "invariants": {
      "rule": "Validate pagination before accessing records."
    },
    "hints": [
      "Work out the input contract before deciding how to fetch.",
      "Distinguish omitted values from malformed or ambiguous input.",
      "Reject input outside page 1–1000 and size 1–50 before reading data."
    ],
    "cases": [
      {
        "id": "defaults",
        "label": "Omitted values use documented defaults",
        "invariant": "rule",
        "action": "list",
        "fixture": {
          "actor": {
            "id": "owner-a",
            "tenant": "north",
            "permissions": [
              "read",
              "list"
            ]
          },
          "resource": null
        },
        "expected": {
          "outcome": "allowed",
          "page": 1,
          "size": 20
        },
        "group": "behavior",
        "weight": 1
      },
      {
        "id": "edge",
        "label": "Maximum accepted values are handled",
        "invariant": "rule",
        "action": "list",
        "fixture": {
          "actor": {
            "id": "reader-a",
            "tenant": "north",
            "permissions": [
              "read",
              "list"
            ]
          },
          "resource": null,
          "page": "1000",
          "size": "50"
        },
        "expected": {
          "outcome": "allowed",
          "page": 1000,
          "size": 50
        },
        "group": "boundary",
        "weight": 1
      },
      {
        "id": "bad-size",
        "label": "An out-of-range value performs no reads",
        "invariant": "rule",
        "action": "list",
        "fixture": {
          "actor": {
            "id": "reader-a",
            "tenant": "north",
            "permissions": [
              "read",
              "list"
            ]
          },
          "resource": null,
          "size": "51"
        },
        "expected": {
          "outcome": "invalid-input",
          "reads": 0
        },
        "group": "boundary",
        "weight": 1
      },
      {
        "id": "malformed",
        "label": "Non-integer input performs no reads",
        "invariant": "rule",
        "action": "list",
        "fixture": {
          "actor": {
            "id": "reader-a",
            "tenant": "north",
            "permissions": [
              "read",
              "list"
            ]
          },
          "resource": null,
          "page": "1.2"
        },
        "expected": {
          "outcome": "invalid-input",
          "reads": 0
        },
        "group": "boundary",
        "weight": 1
      },
      {
        "id": "duplicate",
        "label": "An ambiguous input performs no reads",
        "invariant": "rule",
        "action": "list",
        "fixture": {
          "actor": {
            "id": "reader-a",
            "tenant": "north",
            "permissions": [
              "read",
              "list"
            ]
          },
          "resource": null,
          "size": "20,30"
        },
        "expected": {
          "outcome": "invalid-input",
          "reads": 0
        },
        "group": "boundary",
        "weight": 1
      },
      {
        "id": "signed-in",
        "label": "Signed-in catalog viewers can list",
        "invariant": "rule",
        "action": "list",
        "fixture": {
          "actor": {
            "id": "catalog-reader",
            "permissions": []
          },
          "resource": null
        },
        "expected": {
          "outcome": "allowed",
          "page": 1,
          "size": 20
        },
        "group": "behavior",
        "weight": 1
      }
    ],
    "explanation": "Validate each parameter once, apply defaults only when omitted and perform zero reads on validation failure. Real endpoints should also set query cost and rate limits.",
    "references": [
      {
        "label": "OWASP API Security Top 10 (2023) · API4",
        "url": "https://owasp.org/API-Security/editions/2023/en/0x11-t10/"
      }
    ],
    "reasoning": [
      {
        "id": "principle",
        "label": "Early bounds make the requested work predictable."
      },
      {
        "id": "alternate",
        "label": "A permission check alone controls the amount of work."
      }
    ],
    "correctReason": "principle",
    "mode": "choose-fix",
    "options": [
      {
        "id": "permission-first",
        "label": "Require a catalog permission before validation",
        "checks": [
          "permission",
          "valid-page"
        ],
        "effect": "page"
      },
      {
        "id": "bounded",
        "label": "Validate bounded pagination for signed-in viewers",
        "checks": [
          "signed-in",
          "valid-page"
        ],
        "effect": "page"
      }
    ],
    "solution": "bounded"
  },
  {
    "id": "MVP-06",
