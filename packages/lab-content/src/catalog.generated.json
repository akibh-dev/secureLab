    ],
    "reasoning": [
      {
        "id": "principle",
        "label": "Verified membership defines the workspace boundary."
      },
      {
        "id": "alternate",
        "label": "Only the document owner can read a tenant-wide record."
      }
    ],
    "correctReason": "principle",
    "mode": "choose-fix",
    "options": [
      {
        "id": "owner-only",
        "label": "Require verified tenant and ownership",
        "checks": [
          "tenant",
          "owner"
        ],
        "effect": "access"
      },
      {
        "id": "tenant-scope",
        "label": "Require the verified tenant to match",
