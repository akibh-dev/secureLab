        "label": "An unavailable document reveals no details",
        "invariant": "rule",
        "action": "read",
        "fixture": {
          "actor": {
            "id": "reader-a",
            "tenant": "north",
            "permissions": [
              "read",
              "list"
            ]
          },
          "resource": null
        },
        "expected": {
          "outcome": "restricted"
        },
        "group": "boundary",
        "weight": 10
      },
      {
        "id": "trusted-context",
        "label": "Verified context determines tenant scope",
        "invariant": "rule",
        "action": "read",
        "fixture": {
          "actor": {
            "id": "reader-a",
            "tenant": "north",
            "permissions": [
              "read",
              "list"
            ]
          },
          "resource": {
            "tenant": "north",
            "owner": "owner-a",
            "members": [
