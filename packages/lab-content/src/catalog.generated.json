      {
        "id": "no-membership",
        "label": "An account without a verified tenant is restricted",
        "invariant": "rule",
        "action": "read",
        "fixture": {
          "actor": {
            "id": "guest",
            "permissions": [
              "read"
            ]
          },
          "resource": {
            "tenant": "north",
            "owner": "owner-a",
            "members": [
              "reader-a",
              "owner-a"
            ],
            "visibility": "team",
            "open": true
          }
        },
        "expected": {
          "outcome": "restricted"
        },
        "group": "boundary",
        "weight": 15
      }
    ],
    "explanation": "Use the verified tenant in the real database lookup and in the authorizing rule. This simulation checks the scoped decision and its public outcome.",
    "references": [
      {
        "label": "OWASP API Security Top 10 (2023) · API1",
        "url": "https://owasp.org/API-Security/editions/2023/en/0x11-t10/"
