    "module": "capstones",
    "difficulty": "Advanced",
    "minutes": 25,
    "prerequisites": [
      "MVP-05"
    ],
    "objective": "Apply the minimum permissions for each document action.",
    "scenario": "The fictional Papertrail workspace distinguishes listing, editing and sharing. Configure each action to match the documented permissions and resource boundary.",
    "routes": [
      "GET /api/workspaces/:id/docs",
      "PATCH /api/docs/:id",
      "POST /api/docs/:id/share"
