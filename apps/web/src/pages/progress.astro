---
import Page from "../layouts/Page.astro";
import ProgressPanel from "../features/progress/ProgressPanel";
import { cards } from "../features/progress/cards";
---

<Page title="Progress · SecureLab">
  <h1>Your progress</h1>
  <p>
    Scores and drafts are saved in this browser. Export a copy to move your
    progress to another browser.
  </p>
  <ProgressPanel client:load labs={cards} />
</Page>
