---
import "../../../../packages/ui/src/tokens.css";
interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "Practice writing and verifying defensive policies for fictional APIs.",
} = Astro.props;
const canonical = Astro.site && new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta
      property="og:image"
      content={Astro.site
        ? new URL("/brand/social.png", Astro.site)
        : "/brand/social.png"}
    />
    <link rel="icon" href="/brand/mark.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/brand/touch.png" />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header>
      <div class="bar">
        <a class="brand" href="/" aria-label="SecureLab home"
          ><img
            src="/brand/mark.svg"
            alt=""
            width="28"
            height="28"
          />SecureLab</a
        >
        <nav aria-label="Main"><slot name="navigation" /></nav>
      </div>
    </header>
    <main id="content"><slot /></main>
    <footer><slot name="footer" /></footer>
  </body>
</html>
<style>
  .bar,
  main,
  footer {
    max-width: 88rem;
    margin: auto;
    padding-inline: clamp(1rem, 4vw, 3rem);
  }
  header {
    border-bottom: 1px solid #343d46;
  }
  .bar {
    min-height: 4.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.375rem;
    font-weight: 650;
    color: var(--ink);
    text-decoration: none;
  }
  main {
    padding-block: clamp(2rem, 6vw, 5rem);
  }
  footer {
    padding-block: 1.5rem;
  }
</style>
