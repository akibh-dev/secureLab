---
import "../../../../packages/ui/src/tokens.css";
interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "Practice writing and verifying defensive policies for fictional APIs.",
} = Astro.props;
const canonical = Astro.site && new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta
      property="og:image"
      content={Astro.site
        ? new URL("/brand/social.png", Astro.site)
        : "/brand/social.png"}
    />
    <link rel="icon" href="/brand/mark.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/brand/touch.png" />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header>
      <div class="bar">
        <a class="brand" href="/" aria-label="SecureLab home"
          ><img
            src="/brand/mark.svg"
            alt=""
            width="28"
            height="28"
          />SecureLab</a
        >
        <nav aria-label="Main">
          <a href="/learn/">Learn</a><a href="/labs/">Labs</a><a
            href="/progress/">Progress</a
          >
        </nav>
      </div>
    </header>
    <main id="content"><slot /></main>
    <footer>
      <nav aria-label="Resources">
        <a href="/glossary/">Glossary</a><a href="/about/">About</a><a
          href="/contribute/">Contribute</a
        >
        <a href="/privacy/">Privacy</a><a href="/accessibility/"
          >Accessibility</a
        >
      </nav>
      <small class="muted" id="offline-status" role="status"></small>
    </footer>
  </body>
</html>
<style>
  .bar,
  main,
  footer {
    max-width: 88rem;
    margin: auto;
    padding-inline: clamp(1rem, 4vw, 3rem);
  }
  header {
    border-bottom: 1px solid #343d46;
  }
  .bar {
    min-height: 4.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.375rem;
    font-weight: 650;
    color: var(--ink);
    text-decoration: none;
  }
  main {
    padding-block: clamp(2rem, 6vw, 5rem);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  footer {
    padding-block: 1.5rem;
  }
</style>

<script>
  if (import.meta.env.PROD && "serviceWorker" in navigator) {
    const status = document.getElementById("offline-status");
    navigator.serviceWorker.addEventListener("controllerchange", () => {
      if (status) status.textContent = "Available offline";
    });
    void navigator.serviceWorker
      .register("/sw.js")
      .then(async (registration) => {
        if (registration.waiting && status)
          status.textContent =
            "Close other SecureLab tabs to finish the update.";
        await navigator.serviceWorker.ready;
        if (
          navigator.serviceWorker.controller &&
          status &&
          !registration.waiting
        )
          status.textContent = "Available offline";
      })
      .catch(() => {
        if (status) status.textContent = "Offline setup unavailable";
      });
  }
</script>
